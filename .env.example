# ═══════════════════════════════════════════════════════════
#  FlowBase — Environment Variables Reference
# ═══════════════════════════════════════════════════════════
#
#  HOW TO USE
#  ──────────
#  On Replit  → Store every value in the Secrets panel (lock
#               icon in the sidebar). Never paste real keys here.
#  Local dev  → Copy this file to .env, fill in your values.
#               (.env is gitignored — it will NOT be committed.)
#
#  WHERE TO GET EACH VALUE
#  ───────────────────────
#  Clerk keys     → https://dashboard.clerk.com  › API Keys
#  Database URL   → Replit Database tab (auto-provided) or
#                   https://neon.tech for a free Postgres instance
# ═══════════════════════════════════════════════════════════


# ── Clerk Authentication ─────────────────────────────────────
# Both keys come from Clerk dashboard › API Keys.
# pk_test_* = development  |  pk_live_* = production

CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Frontend alias — must equal CLERK_PUBLISHABLE_KEY exactly.
# Vite only exposes variables that start with VITE_ to the browser.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk proxy URL — set automatically in production by Replit.
# Leave blank for local development.
VITE_CLERK_PROXY_URL=


# ── Database (PostgreSQL) ────────────────────────────────────
# Replit auto-provides all PG* vars and DATABASE_URL when you
# add a Postgres database from the Database tab.
# For local dev, use your own connection string.

DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Individual connection params (auto-provided by Replit Postgres):
PGHOST=your-pg-host
PGPORT=5432
PGDATABASE=your-db-name
PGUSER=your-pg-user
PGPASSWORD=your-pg-password


# ── API Server ───────────────────────────────────────────────
# PORT is assigned automatically by Replit — do not set manually.
# PORT=5000

# Log verbosity: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Node environment: development | production | test
NODE_ENV=development

# Secret used to sign server-side sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string


# ── Replit Runtime (auto-provided — do not set manually) ─────
# These are injected by Replit at runtime. Listed here for reference.
#
# REPLIT_DEV_DOMAIN   → your-repl.replit.dev  (dev preview domain)
# REPLIT_DOMAINS      → comma-separated list of all domains for this Repl
# REPL_ID             → unique identifier for this Repl
