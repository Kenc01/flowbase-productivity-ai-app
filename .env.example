# ─────────────────────────────────────────────
# FlowBase — Environment Variables Template
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# On Replit, all values are stored in the Secrets
# panel (lock icon) — NOT in this file.
# ─────────────────────────────────────────────

# ── Clerk Authentication ──────────────────────
# Get these from: https://dashboard.clerk.com
# or from your Replit Secrets panel.

CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...   # same value as CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_...

# ── Database ──────────────────────────────────
# Replit auto-provides DATABASE_URL via the
# managed Postgres integration. For local dev,
# use your own Postgres or Neon connection string.

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── App URLs (Next.js legacy — not used in Vite) ──
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
